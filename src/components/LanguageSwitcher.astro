---
import { getLocale, localizedHref } from '../i18n';
const locale = getLocale(Astro.url.pathname);
---
<label class="language-switcher">
	<span class="visually-hidden">{locale === 'en' ? 'Language' : 'Sprache'}</span>
	<select data-language-switch aria-label={locale === 'en' ? 'Language' : 'Sprache'}>
		<option value={localizedHref(Astro.url.pathname, 'de')} selected={locale === 'de'} lang="de">Deutsch</option>
		<option value={localizedHref(Astro.url.pathname, 'en')} selected={locale === 'en'} lang="en">English</option>
	</select>
</label>

<style>
	.visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
	.language-switcher { flex-shrink: 0; margin-inline-end: auto; }
	select { min-height: var(--touch-min); max-width: 7.5rem; padding: .5rem 1.5rem .5rem .5rem; border: 1px solid rgb(74 52 40 / .2); border-radius: var(--radius-sm); background-color: transparent; color: var(--color-brown); font: inherit; font-size: .8125rem; cursor: pointer; }
	select:focus-visible { outline: 2px solid var(--color-brown); outline-offset: 3px; }
	@media (max-width: 30rem) { select { max-width: 6rem; padding-inline-end: .25rem; } }
</style>

<script>
	document.querySelectorAll<HTMLSelectElement>('[data-language-switch]').forEach((switcher) => switcher.addEventListener('change', (event) => {
		const select = event.currentTarget as HTMLSelectElement;
		document.dispatchEvent(new Event('language-changing'));
		const target = new URL(select.value, location.origin);
		target.search = location.search;
		target.hash = location.hash;
		location.assign(target.href);
	}));
</script>
