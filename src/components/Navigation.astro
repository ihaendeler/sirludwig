---
import { getLocale, translator, localizedHref } from '../i18n';
const locale = getLocale(Astro.url.pathname);
const t = translator(locale);
import { mainNavigation } from '../config/navigation';
import Brand from './Brand.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

const navItems = mainNavigation;
const currentPath = localizedHref(Astro.url.pathname, 'de')!.replace(/\/$/, '') || '/';
---

<header class="site-header" data-site-header>
	<div class="site-header__inner container">
		<Brand href={localizedHref("/", locale)} class="site-header__brand" />

		<button
			type="button"
			class="nav-toggle nav-toggle--open"
			aria-expanded="false"
			aria-controls="site-nav"
			aria-label={t("Menü öffnen")}
		>
			<span class="nav-toggle__bar" aria-hidden="true"></span>
			<span class="nav-toggle__bar" aria-hidden="true"></span>
			<span class="nav-toggle__bar" aria-hidden="true"></span>
		</button>
	</div>

	<div class="nav-overlay" data-nav-overlay hidden></div>

	<nav id="site-nav" class="site-nav" aria-label={t("Hauptnavigation")} hidden>
		<div class="site-nav__head container">
			<Brand href={localizedHref("/", locale)} class="site-nav__brand" />

			<button type="button" class="nav-toggle nav-toggle--close" aria-label={t("Menü schließen")}>
				<span class="nav-toggle__bar" aria-hidden="true"></span>
				<span class="nav-toggle__bar" aria-hidden="true"></span>
				<span class="nav-toggle__bar" aria-hidden="true"></span>
			</button>
		</div>

		<div class="site-nav__body container">
			<ul class="site-nav__list">
				{
					navItems.map((item) => (
						<li class="site-nav__item">
							<a href={localizedHref(item.href, locale)} class="site-nav__link" data-nav-link aria-current={currentPath === item.href ? 'page' : undefined}>
								{t(item.label)}
							</a>
						</li>
					))
				}
			</ul>
			<div class="site-nav__language">
				<span class="site-nav__language-label">{t('Sprache')}</span>
				<LanguageSwitcher />
			</div>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		height: var(--header-height);
		background-color: var(--color-cream);
		box-shadow: var(--shadow-header);
		isolation: isolate;
	}

	.site-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: .75rem;
		height: 100%;
	}

	.site-header__brand {
		min-height: var(--touch-min);
		padding-inline: var(--space-2xs);
	}

	@media (max-width: 30rem) {
		.site-header__inner, .site-nav__head { gap: .5rem; }
		.site-header__brand, .site-nav__brand { width: 8rem; min-width: 0; padding-inline: 0; }
		:is(.site-header__brand, .site-nav__brand) :global(.brand__name) { font-size: 1.05rem; }
		:is(.site-header__brand, .site-nav__brand) :global(.brand__tagline) { max-width: 7.5rem; font-size: .6rem; }
	}

	.nav-toggle {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 0.3125rem;
		flex-shrink: 0;
		width: var(--touch-min);
		height: var(--touch-min);
		border-radius: var(--radius-sm);
		color: var(--color-brown);
	}

	.nav-toggle:focus-visible {
		outline: 2px solid var(--color-brown);
		outline-offset: 3px;
	}

	.nav-toggle__bar {
		display: block;
		width: 1.25rem;
		height: 1px;
		background-color: currentColor;
		transition:
			transform var(--transition-fast),
			opacity var(--transition-fast);
	}

	.nav-toggle--open[aria-expanded='true'] .nav-toggle__bar:nth-child(1) {
		transform: translateY(0.4375rem) rotate(45deg);
	}

	.nav-toggle--open[aria-expanded='true'] .nav-toggle__bar:nth-child(2) {
		opacity: 0;
	}

	.nav-toggle--open[aria-expanded='true'] .nav-toggle__bar:nth-child(3) {
		transform: translateY(-0.4375rem) rotate(-45deg);
	}

	.nav-toggle--close .nav-toggle__bar:nth-child(1) {
		transform: translateY(0.4375rem) rotate(45deg);
	}

	.nav-toggle--close .nav-toggle__bar:nth-child(2) {
		opacity: 0;
	}

	.nav-toggle--close .nav-toggle__bar:nth-child(3) {
		transform: translateY(-0.4375rem) rotate(-45deg);
	}

	.nav-overlay {
		position: fixed;
		inset: 0;
		z-index: 110;
		background-color: rgb(74 52 40 / 0.1);
		opacity: 0;
		pointer-events: none;
	}

	.nav-overlay.is-visible {
		opacity: 1;
		pointer-events: auto;
	}

	.site-nav {
		position: fixed;
		inset: 0;
		z-index: 120;
		display: flex;
		flex-direction: column;
		background-color: var(--color-cream);
		overflow-y: auto;
		-webkit-overflow-scrolling: touch;
		padding-top: env(safe-area-inset-top, 0);
		opacity: 0;
		pointer-events: none;
	}

	.site-nav.is-open {
		opacity: 1;
		pointer-events: auto;
	}

	.site-nav__head {
		display: flex;
		gap: .75rem;
		align-items: center;
		justify-content: space-between;
		flex-shrink: 0;
		min-height: var(--header-height);
		border-bottom: 1px solid rgb(74 52 40 / 0.06);
	}

	.site-nav__brand {
		min-height: var(--touch-min);
		padding-inline: var(--space-2xs);
	}

	.site-nav__body {
		flex: 1;
		padding-block: var(--space-xl) calc(var(--space-2xl) + env(safe-area-inset-bottom, 0));
	}

	.site-nav__list {
		display: flex;
		flex-direction: column;
		gap: var(--space-2xs);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-nav__language {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-md);
		margin-top: var(--space-lg);
		padding-top: var(--space-md);
		border-top: 1px solid rgb(74 52 40 / .12);
	}
	.site-nav__language-label { font-size: .8125rem; color: rgb(74 52 40 / .65); }

	.site-nav__item + .site-nav__item {
		border-top: none;
	}

	.site-nav__link {
		display: flex;
		align-items: center;
		min-height: var(--touch-min);
		padding: var(--space-sm) var(--space-2xs);
		font-family: var(--font-display);
		font-size: clamp(1.25rem, 4.2vw, 1.4375rem);
		font-weight: 400;
		line-height: 1.3;
		letter-spacing: -0.015em;
		color: var(--color-black);
		text-decoration: none;
		transition: color var(--transition-fast);
	}

	.site-nav__link:hover {
		color: var(--color-apricot-dark);
	}

	.site-nav__link:focus-visible {
		outline: 2px solid var(--color-brown);
		outline-offset: 4px;
		color: var(--color-black);
	}

	.site-header.is-menu-open .site-header__inner {
		visibility: hidden;
	}

	@media (min-width: 80rem) {
		.nav-toggle,
		.nav-overlay,
		.site-nav__head {
			display: none;
		}

		.site-header.is-menu-open .site-header__inner {
			visibility: visible;
		}

		.site-nav {
			position: absolute;
			inset: auto;
			top: 0;
			right: var(--page-gutter);
			display: flex !important;
			flex-direction: row;
			align-items: center;
			width: auto;
			height: var(--header-height);
			padding: 0;
			background: none;
			overflow: visible;
			opacity: 1;
			pointer-events: auto;
		}

		.site-nav__body {
			display: flex;
			align-items: center;
			padding: 0;
		}

		.site-nav__language { margin: 0 0 0 1rem; padding: 0 0 0 .75rem; border-top: 0; border-left: 1px solid rgb(74 52 40 / .12); }
		.site-nav__language-label { display: none; }

		.site-header__inner {
			gap: var(--space-lg);
		}

		.site-header {
			display: flex;
			align-items: center;
		}

		.site-header > .container.site-header__inner {
			flex: 1;
		}

		.site-nav__list {
			flex-direction: row;
			gap: .25rem;
		}

		.site-nav__item + .site-nav__item {
			border-top: none;
		}

		.site-nav__link {
			min-height: var(--touch-min);
			padding: var(--space-xs) .65rem;
			font-family: var(--font-display);
			font-size: clamp(0.9375rem, 1.05vw, 1.0625rem);
			font-weight: 400;
			line-height: 1.3;
			letter-spacing: -0.01em;
			color: rgb(74 52 40 / 0.82);
			text-decoration: none;
			transition: color var(--transition-fast);
		}

		.site-nav__link:hover,
		.site-nav__link:focus-visible {
			color: var(--color-apricot-dark);
			background-color: transparent;
		}
	}

 .site-nav__link[aria-current='page'] { color: var(--color-brown); text-decoration: underline; text-underline-offset: .4em; text-decoration-thickness: 1px; }
</style>

<script>
	import '../scripts/navigation';
</script>
