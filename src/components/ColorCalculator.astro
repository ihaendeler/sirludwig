---
import { getLocale, translator, localizedHref } from '../i18n';
const locale = getLocale(Astro.url.pathname);
const t = translator(locale);
import { Image } from 'astro:assets';
import TuxedoGuide from './TuxedoGuide.astro';
import { photos } from '../data/photos';
import { calculateColors, emptyScenario, GENOTYPE_LABELS, LOCI, LOCUS_LABELS, VALUES, MODEL_NOTE } from '../lib/color/model';
import '../styles/color-calculator.css';

const initial = emptyScenario();
const result = calculateColors(initial);
const prefix = 'color';
---

<color-calculator class="color-calculator">
	<div class="color-calculator__layout">
		<div class="color-calculator__inputs">
			<div class="color-sire">
				<Image src={photos.blickkontakt.image} alt={t("Sir Ludwig")} format="webp" width={88} height={104} fit="cover" class="color-sire__photo" />
				<div>
					<p class="color-eyebrow">{t("Der Rüde")}</p>
					<h2 class="color-sire__name">{t("Sir Ludwig")}</h2>
					<p class="color-sire__genes">{t("e1/e1 · N/bs · Kb/Kb · N/S")}</p>
					<a class="color-text-link" href={localizedHref("/gesundheit#health-e-lokus", locale)}>{t("Gentests ansehen")}</a>
				</div>
			</div>

			<fieldset class="color-genetics">
				<legend>{t("Farbtest der Hündin")}</legend>
				<div class="color-genetics__fields">
					{LOCI.map((locus) => (
						<div class="color-field">
							<label class="color-field__label" for={`${prefix}-${locus}`}>{t(LOCUS_LABELS[locus])}</label>
							<select id={`${prefix}-${locus}`} data-color-locus={locus}>
								{VALUES[locus].map((value) => <option value={value} selected={initial[locus] === value}>{t(value === 'unknown' ? 'Bitte wählen' : GENOTYPE_LABELS[locus][value])}</option>)}
							</select>
						</div>
					))}
				</div>
			</fieldset>
			<p class="color-status" data-color-status role="status" aria-live="polite"></p>
		</div>

		<section class="color-results" aria-labelledby={`${prefix}-result-title`}>
			<div class="color-results__head">
				<div><p class="color-eyebrow">{t("Ergebnis")}</p><h2 id={`${prefix}-result-title`}>{t("Was ist möglich?")}</h2></div>
				<span class="color-results__live">{t("Ludwig × Hündin")}</span>
			</div>
			<p class="color-results__intro">{t("Grundfarben im Modell · Wahrscheinlichkeit pro Welpe")}</p>
			<div class="color-results__colors" data-color-results>
				{result.colors.map((color) => (
					<div class="color-result" data-color-result={color.id} data-zero="true">
						<span class:list={['color-swatch', `color-swatch--${color.id}`]} aria-hidden="true"></span>
						<div class="color-result__label"><span>{t(color.label)}</span><strong data-color-probability>—</strong></div>
					</div>
				))}
			</div>
			<p class="color-help">{t("Berechnet E/e1 und die Braunvariante bs. Andere Varianten und der genaue Farbton bleiben offen.")}</p>
			<p class="color-help" data-color-pending>{t("Für die Grundfarben E- und B-Lokus auswählen.")}</p>
			<div class="color-spotting">
				<h3>{t("Tuxedo und Weißzeichnung")}</h3>
				<p>{t("Diese Werte zeigen die Vererbung der getesteten S-Variante. Sie geben keinen Anteil an Tuxedo-Welpen an.")}</p>
				<dl class="color-spotting__grid">
					{result.spotting.map((s) => <div><dt>{t(s.genotype)}<span>{t(s.label)}</span></dt><dd data-color-spotting={s.genotype}>—</dd></div>)}
				</dl>
				<p class="color-help" data-spotting-pending>{t("Für die Weißscheckung S-Lokus auswählen.")}</p>
				<a class="color-text-link" href={localizedHref(`#${prefix}-tuxedo`, locale)} data-color-guide>{t("Tuxedo-Vererbung und Wurfverteilung verstehen")}</a>
			</div>
			<div class="color-result-actions">
				<a href={localizedHref("/deckanfrage/", locale)} class="btn btn--primary" data-color-inquire>{t("Mit dieser Kombination anfragen")}</a>
			</div>
		</section>
	</div>
	<TuxedoGuide id={`${prefix}-tuxedo`} />
	<details class="color-method">
		<summary>{t("So funktioniert die Berechnung")}</summary>
		<div>
			<p>{t(MODEL_NOTE)}</p>
			<p>{t("Ludwig gibt Kb an alle Nachkommen weiter. Im Modell bestimmt E/e1, ob eine rotbasierte Farbe sichtbar wird. Die Variante bs kann dunkles Pigment braun verändern. Die dargestellten Farbfelder sind Orientierungshilfen für Farbgruppen, keine Vorhersage eines einzelnen Welpen.")}</p>
			<p>{t("Beim B-Lokus steht N hier für das Fehlen der Variante bs. Das schließt andere Braunvarianten nicht aus.")}</p>
			<ul>
				<li><a href="https://vgl.ucdavis.edu/test/mc1r-dog" target="_blank" rel="noopener noreferrer">{t("UC Davis: E-Lokus")}</a></li>
				<li><a href="https://vgl.ucdavis.edu/test/brown-dog" target="_blank" rel="noopener noreferrer">{t("UC Davis: Braunvererbung")}</a></li>
				<li><a href="https://vgl.ucdavis.edu/test/dominant-black" target="_blank" rel="noopener noreferrer">{t("UC Davis: K-Lokus")}</a></li>
				<li><a href="https://vgl.ucdavis.edu/test/piebald-dog" target="_blank" rel="noopener noreferrer">{t("UC Davis: Weißscheckung")}</a></li>
				<li><a href="https://embarkvet.com/blogs/resources/embark-for-breeders-dog-dna-test-includes-white-spotting" target="_blank" rel="noopener noreferrer">{t("Embark: Weißzeichnung und Grenzen des S-Lokus-Tests")}</a></li>
			</ul>
		</div>
	</details>
	<noscript><p class="color-help">{t("Für den Farbrechner aktivieren Sie bitte JavaScript.")}</p></noscript>
</color-calculator>

<script>
	import '../scripts/color-calculator';
</script>
