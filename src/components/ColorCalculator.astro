---
import { Image } from 'astro:assets';
import TuxedoGuide from './TuxedoGuide.astro';
import ludwigImage from '../assets/images/hero/PXL_20260516_084223542.jpg';
import { calculateColors, emptyScenario, GENOTYPE_LABELS, LOCI, LOCUS_LABELS, VALUES, MODEL_NOTE } from '../lib/color/model';
import '../styles/color-calculator.css';

interface Props { embedded?: boolean }
const { embedded = false } = Astro.props;
const initial = emptyScenario();
const result = calculateColors(initial);
const prefix = embedded ? 'inquiry-color' : 'color';
---

<color-calculator class:list={['color-calculator', { 'color-calculator--embedded': embedded }]} data-embedded={String(embedded)}>
	<div class="color-calculator__layout">
		<div class="color-calculator__inputs">
			<div class="color-sire">
				<Image src={ludwigImage} alt="Sir Ludwig" width={88} height={104} fit="cover" class="color-sire__photo" />
				<div>
					<p class="color-eyebrow">Der Rüde</p>
					<h2 class="color-sire__name">Sir Ludwig</h2>
					<p class="color-sire__genes">e1/e1 · N/bs · Kb/Kb · N/S</p>
					<a class="color-text-link" href="/gesundheit#health-e-lokus">Gentests ansehen</a>
				</div>
			</div>

			<fieldset class="color-genetics">
				<legend>Farbtest der Hündin</legend>
				<div class="color-genetics__fields">
					{LOCI.map((locus) => (
						<div class="color-field">
							<label class="color-field__label" for={`${prefix}-${locus}`}>{LOCUS_LABELS[locus]}</label>
							<select id={`${prefix}-${locus}`} data-color-locus={locus}>
								{VALUES[locus].map((value) => <option value={value} selected={initial[locus] === value}>{value === 'unknown' ? 'Bitte wählen' : GENOTYPE_LABELS[locus][value]}</option>)}
							</select>
						</div>
					))}
				</div>
			</fieldset>
			<p class="color-status" data-color-status role="status" aria-live="polite"></p>
		</div>

		<section class="color-results" aria-labelledby={`${prefix}-result-title`}>
			<div class="color-results__head">
				<div><p class="color-eyebrow">Ergebnis</p><h2 id={`${prefix}-result-title`}>Was ist möglich?</h2></div>
				<span class="color-results__live">Ludwig × Hündin</span>
			</div>
			<p class="color-results__intro">Grundfarben im Modell · Wahrscheinlichkeit pro Welpe</p>
			<div class="color-results__colors" data-color-results>
				{result.colors.map((color) => (
					<div class="color-result" data-color-result={color.id} data-zero="true">
						<span class:list={['color-swatch', `color-swatch--${color.id}`]} aria-hidden="true"></span>
						<div class="color-result__label"><span>{color.label}</span><strong data-color-probability>—</strong></div>
					</div>
				))}
			</div>
			<p class="color-help">Berechnet E/e1 und die Braunvariante bs. Andere Varianten und der genaue Farbton bleiben offen.</p>
			<p class="color-help" data-color-pending>Für die Grundfarben E- und B-Lokus auswählen.</p>
			<div class="color-spotting">
				<h3>Tuxedo und Weißzeichnung</h3>
				<p>Diese Werte zeigen die Vererbung der getesteten S-Variante. Sie geben keinen Anteil an Tuxedo-Welpen an.</p>
				<dl class="color-spotting__grid">
					{result.spotting.map((s) => <div><dt>{s.genotype}<span>{s.label}</span></dt><dd data-color-spotting={s.genotype}>—</dd></div>)}
				</dl>
				<p class="color-help" data-spotting-pending>Für die Weißscheckung S-Lokus auswählen.</p>
				<a class="color-text-link" href={`#${prefix}-tuxedo`} data-color-guide>Tuxedo-Vererbung und Wurfverteilung verstehen</a>
			</div>
			<div class="color-result-actions">
				{embedded ? <button type="button" class="btn btn--primary" data-color-apply>Für meine Anfrage übernehmen</button> : <a href="/deckanfrage" class="btn btn--primary" data-color-inquire>Mit dieser Kombination anfragen</a>}
				<button type="button" class="color-text-link" data-color-share>Szenario teilen</button>
			</div>
			<p class="color-help">Der Link enthält nur die ausgewählten Farbwerte.</p>
			<div class="color-copy-fallback" data-color-copy hidden>
				<label for={`${prefix}-share-url`}>Link zum Kopieren</label>
				<input id={`${prefix}-share-url`} type="url" readonly data-color-share-url />
			</div>
		</section>
	</div>
	{embedded ? <details class="tuxedo-guide-disclosure" id={`${prefix}-tuxedo`}>
		<summary>Wie sich Ludwigs Tuxedo-Look vererbt</summary>
		<TuxedoGuide id={`${prefix}-tuxedo-guide`} compact />
	</details> : <TuxedoGuide id={`${prefix}-tuxedo`} />}
	<details class="color-method">
		<summary>So funktioniert die Berechnung</summary>
		<div>
			<p>{MODEL_NOTE}</p>
			<p>Ludwig gibt Kb an alle Nachkommen weiter. Im Modell bestimmt E/e1, ob eine rotbasierte Farbe sichtbar wird. Die Variante bs kann dunkles Pigment braun verändern. Die dargestellten Farbfelder sind Orientierungshilfen für Farbgruppen, keine Vorhersage eines einzelnen Welpen.</p>
			<p>Beim B-Lokus steht N hier für das Fehlen der Variante bs. Das schließt andere Braunvarianten nicht aus.</p>
			<ul>
				<li><a href="https://vgl.ucdavis.edu/test/mc1r-dog" target="_blank" rel="noopener noreferrer">UC Davis: E-Lokus</a></li>
				<li><a href="https://vgl.ucdavis.edu/test/brown-dog" target="_blank" rel="noopener noreferrer">UC Davis: Braunvererbung</a></li>
				<li><a href="https://vgl.ucdavis.edu/test/dominant-black" target="_blank" rel="noopener noreferrer">UC Davis: K-Lokus</a></li>
				<li><a href="https://vgl.ucdavis.edu/test/piebald-dog" target="_blank" rel="noopener noreferrer">UC Davis: Weißscheckung</a></li>
				<li><a href="https://embarkvet.com/blogs/resources/embark-for-breeders-dog-dna-test-includes-white-spotting" target="_blank" rel="noopener noreferrer">Embark: Weißzeichnung und Grenzen des S-Lokus-Tests</a></li>
			</ul>
		</div>
	</details>
	<noscript><p class="color-help">Für den Farbrechner aktivieren Sie bitte JavaScript.</p></noscript>
</color-calculator>

<script>
	import '../scripts/color-calculator';
</script>
