---
import { getLocale, translator, localizedHref, formatDate } from '../i18n';
const locale = getLocale(Astro.url.pathname);
const t = translator(locale);
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { siteConfig, getCanonical } from '../config/site';
import {
	getCertificateUrl,
	getHealthRecord,
	healthReportSections,
} from '../data/health';
import '../styles/gesundheit.css';

const path = '/gesundheit';

const pageTitle = `Gesundheit & Untersuchungen — ${siteConfig.brandName}`;
const pageDescription =
	'Transparente Übersicht der genetischen, orthopädischen und augenärztlichen Untersuchungen von Sir Ludwig — Ergebnisse verständlich erklärt, Originalzertifikate als offizieller Nachweis.';
---

<BaseLayout title={t(pageTitle)} description={t(pageDescription)} canonical={getCanonical(path)}>
	<PageHero
		title={t("Gesundheit")}
		intro={t("Untersuchungsergebnisse werden hier verständlich eingeordnet. Originalzertifikate dienen als offizieller Nachweis.")}
		headingId="health-heading"
	/>

	<section class="health-section" aria-label={t("Untersuchungsergebnisse")}>
		<div class="container">
			<div class="health-report">
				{
					healthReportSections.map((section) => (
						<section
							class="health-area health-area--report"
							id={`health-area-${section.id}`}
							aria-labelledby={`health-report-${section.id}`}
						>
							<header class="health-area__header">
								<h2 class="health-area__title" id={`health-report-${section.id}`}>
									{t(section.title)}
								</h2>
								<p class="health-area__intro">{t(section.intro)}</p>
							</header>

							{
								section.subsections?.map((subsection) => (
									<div class="health-area__subsection health-area__subsection--report">
										<h3 class="health-area__subsection-title">{t(subsection.title)}</h3>
										<table class="health-table">
											<thead>
												<tr>
													<th scope="col">{t("Untersuchung")}</th>
													<th scope="col">{t("Ergebnis")}</th>
												</tr>
											</thead>
											<tbody>
												{
													subsection.recordIds.map((recordId) => {
														const record = getHealthRecord(recordId);
														const certificateUrl = getCertificateUrl(record.pdf);

														return (
															<tr class="health-table__entry">
																<td colspan={2} class="health-table__entry-cell">
																	<details
																		class="health-table__accordion"
																		id={`health-${record.id}`}
																	>
																		<summary class="health-table__summary">
																			<span class="health-table__summary-name">
																				{t(record.tableLabel)}
																			</span>
																			<span class="health-table__summary-result">
																				<span class="health-table__result-text">
																					{t(record.tableResult)}
																				</span>
																				<span
																					class="health-table__chevron"
																					aria-hidden="true"
																				/>
																			</span>
																		</summary>
																		<div class="health-table__panel">
																			<div class="health-table__panel-inner">
																				<dl class="health-table__detail">
																					<div class="health-table__detail-row">
																						<dt>{t("Kurzbewertung")}</dt>
																						<dd>{t(record.summary)}</dd>
																					</div>
																					{record.breeding && (<div class="health-table__detail-row">
																						<dt>{t("Zuchtrelevanz")}</dt>
																						<dd>{t(record.breeding)}</dd>
																					</div>)}
																					{record.date && (<div class="health-table__detail-row">
																						<dt>{t("Untersuchungsdatum")}</dt>
																						<dd>{formatDate(record.date, locale)}</dd>
																					</div>)}
																				</dl>
																				{record.pdf && (<div class="health-table__actions">
																					<a
																						class="health-table__action"
																						href={localizedHref(certificateUrl, locale)}
																						target="_blank"
																						rel="noopener noreferrer"
																					>
																						{t("Originalzertifikat ansehen")}
																					</a>
																				</div>)}
																			</div>
																		</div>
																	</details>
																</td>
															</tr>
														);
													})
												}
											</tbody>
										</table>
									</div>
								))
							}
							{section.pendingNotice && (
								<div class="health-pending">
									<p class="health-pending__notice">{t(section.pendingNotice)}</p>
									<ul class="health-pending__list">
										{section.recordIds?.map((recordId) => {
											const record = getHealthRecord(recordId);
											return (
												<li class="health-pending__item" id={`health-${record.id}`}>
													{t(record.navLabel)}
												</li>
											);
										})}
									</ul>
								</div>
							)}
						</section>
					))
				}
			</div>
		</div>
	</section>
</BaseLayout>

<script>
	function openHealthAccordionFromHash() {
		const id = window.location.hash.slice(1);
		if (!id.startsWith('health-')) return;

		const target = document.getElementById(id);
		if (!(target instanceof HTMLDetailsElement)) return;

		target.open = true;
		target.scrollIntoView({ behavior: 'smooth', block: 'start' });
	}

	openHealthAccordionFromHash();
	window.addEventListener('hashchange', openHealthAccordionFromHash);
</script>
