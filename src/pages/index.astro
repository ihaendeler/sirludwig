---
import { getLocale, translator, localizedHref } from '../i18n';
const locale = getLocale(Astro.url.pathname);
const t = translator(locale);
export const prerender = true;

import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { defaultDescription, defaultTitle, getCanonical, siteConfig } from '../config/site';
import '../styles/home.css';

import { photos } from '../data/photos';

const mobileWidths = [480, 640, 828, 1080, 1280, 1920];

const features = [
	{
		title: 'Stammbaum',
		tagline: 'Abstammung, Linien und Herkunft.',
		href: '/stammbaum',
		teaser:
			'Abstammung und Linienführung im Überblick. Die Dokumentation wird mit dem Registerprojekt ergänzt.',
		image: photos.standGegenlicht.image,
		alt: photos.standGegenlicht.alt,
		position: 'center center',
		sizes: '(min-width: 64rem) 30vw, 100vw',
	},
	{
		title: 'Gesundheit',
		tagline: 'Untersuchungen, Ergebnisse und Dokumentation.',
		href: '/gesundheit',
		teaser:
			'Untersuchungen und Gesundheitsüberwachung im Rahmen der Entwicklung. Ergebnisse folgen nach Abschluss.',
		image: photos.ruhe.image,
		alt: photos.ruhe.alt,
		position: 'center center',
		sizes: '(min-width: 64rem) 30vw, 100vw',
	},
	{
		title: 'Galerie',
		tagline: 'Entwicklung, Alltag und Eindrücke.',
		href: '/galerie',
		teaser:
			'Einblicke in Typ, Haltung und Alltag — visuell dokumentiert, ohne Übertreibung.',
		image: photos.bewegung.image,
		alt: photos.bewegung.alt,
		position: 'center center',
		sizes: '(min-width: 64rem) 30vw, 100vw',
	},
];

const profileFields = [
	{ label: 'Geboren', value: 'xx.xx.xxxx' },
	{ label: 'Farbe', value: 'Tuxedo Apricot-Weiß' },
	{ label: 'Größe', value: 'in Entwicklung' },
	{ label: 'Gewicht', value: 'in Entwicklung' },
	{ label: 'Registrierung', value: 'FRZ — Registerprojekt' },
	{ label: 'Wohnort / Region', value: 'folgt' },
];

const timelineEntries = [
	{ phase: '2025', heading: 'Geburt' },
	{ phase: '2026', heading: 'Registerverfahren & Gesundheitstests' },
	{ phase: '2026', heading: 'ZTP & Ausstellungen' },
	{ phase: '2027', heading: 'Erste Nachzucht — geplant' },
];
---

<BaseLayout
	title={t(defaultTitle)}
	description={t(defaultDescription)}
	canonical={getCanonical('/')}
>
	<!-- 1. Hero -->
	<section class="home-hero" aria-labelledby="home-hero-brand">
		<div class="home-hero__media home-media">
			<Image
				src={photos.blickkontakt.image}
				alt={t(photos.blickkontakt.alt)}
				format="webp"
				widths={mobileWidths}
				sizes="(min-width: 64rem) 30rem, 100vw"
				loading="eager"
				fetchpriority="high"
				decoding="async"
				class="home-media__img"
			/>
		</div>
		<div class="home-hero__content container">
			<h1 id="home-hero-brand" class="home-hero__brand">{t(siteConfig.brandName)}</h1>
			<p class="home-hero__subtitle">{t(siteConfig.heroSubtitle)}</p>
			<p class="home-hero__intro">
				{t("Tuxedo Großpudel aus ausgewählten Linien. Dokumentation von Entwicklung, Gesundheit und zukünftigem Zuchteinsatz.")}
			</p>
			<div class="home-hero__actions">
				<a class="btn btn--primary" href={localizedHref("/farbrechner", locale)}>{t("Farbmöglichkeiten entdecken")}</a>
				<a class="btn btn--secondary" href={localizedHref("/deckanfrage", locale)}>{t("Deckanfrage")}</a>
			</div>
		</div>
	</section>

	<!-- 2. Feature areas -->
	<section class="home-section home-features" aria-labelledby="features-heading" data-reveal>
		<div class="container">
			<header class="home-features__intro">
				<p class="section-eyebrow">{t("Sir Ludwig")}</p>
				<h2 id="features-heading" class="section-title">{t("Überblick")}</h2>
				<p class="home-section__lead">
					{t("Die wesentlichen Bereiche — sachlich dokumentiert und schrittweise ergänzt.")}
				</p>
			</header>

			<div class="home-features__grid">
				{
					features.map((item) => (
						<article class="home-feature">
							<div
								class="home-feature__media home-media"
								style={`--media-position: ${item.position}`}
							>
								<Image
									src={item.image}
									alt={t(item.alt)}
									format="webp"
									widths={mobileWidths}
									sizes={item.sizes}
									loading="lazy"
									decoding="async"
									class="home-media__img"
								/>
							</div>
							<div class="home-feature__body">
								<hr class="home-feature__line" />
								<h3 class="home-feature__title">
									<a href={localizedHref(item.href, locale)} class="home-feature__link">
										{t(item.title)}
									</a>
								</h3>
								<p class="home-feature__tagline">{t(item.tagline)}</p>
								<p class="home-feature__teaser">{t(item.teaser)}</p>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<!-- 3. Steckbrief -->
	<section class="home-section home-profile" aria-labelledby="profile-heading" data-reveal>
		<div class="container">
			<header class="home-profile__header">
				<p class="section-eyebrow">{t("Daten")}</p>
				<h2 id="profile-heading" class="section-title">{t("Steckbrief")}</h2>
				<p class="home-section__lead">
					{t("Aktuelle Eckdaten. Offene Felder werden ergänzt, sobald die Werte vorliegen.")}
				</p>
			</header>

			<dl class="home-profile__grid">
				{
					profileFields.map((field) => (
						<div class="home-profile__cell">
							<dt class="home-profile__label">{t(field.label)}</dt>
							<dd class="home-profile__value">{t(field.value)}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<!-- 4. Timeline -->
	<section class="home-section home-timeline" aria-labelledby="timeline-heading" data-reveal>
		<div class="container">
			<header class="home-timeline__header">
				<p class="section-eyebrow">{t("Werdegang")}</p>
				<h2 id="timeline-heading" class="section-title">{t("Entwicklung")}</h2>
				<p class="home-section__lead">
					{t("Geplanter Werdegang — ohne verbindliche Zusage zu einzelnen Terminen.")}
				</p>
			</header>

			<ol class="home-timeline__track">
				{
					timelineEntries.map((entry) => (
						<li class="home-timeline__entry">
							<span class="home-timeline__marker" aria-hidden="true" />
							<div class="home-timeline__body">
								<p class="home-timeline__phase">{t(entry.phase)}</p>
								<h3 class="home-timeline__heading">{t(entry.heading)}</h3>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="home-section home-scene" aria-labelledby="scene-heading">
		<div class="container">
			<figure class="home-scene__figure">
				<Image src={photos.talblickQuer.image} alt={t(photos.talblickQuer.alt)}
					format="webp" widths={[640, 960, 1280, 1600, 1920, 2400]}
					sizes="(min-width: 75rem) 67rem, 100vw" loading="lazy" decoding="async" />
				<figcaption>
					<h2 id="scene-heading" class="section-title">{t('Draußen in seinem Element')}</h2>
					<a href={localizedHref('/galerie#everyday', locale)}>{t('Mehr aus dem Alltag ansehen')}</a>
				</figcaption>
			</figure>
		</div>
	</section>

	<!-- 5. Trust -->
	<section class="home-section home-trust" aria-labelledby="trust-heading" data-reveal>
		<div class="container">
			<div class="home-trust__inner">
				<h2 id="trust-heading" class="section-title">{t("Dokumentation statt Versprechen")}</h2>
				<p class="home-trust__text">
					{t("Gesundheit, Abstammung und Entwicklung werden Schritt für Schritt dokumentiert. Ergebnisse und Unterlagen werden nach Vorliegen veröffentlicht.")}
				</p>
			</div>
		</div>
	</section>

	<!-- 6. Highlight -->
	<section
		class="home-section home-highlight home-highlight--reverse"
		aria-labelledby="highlight-heading"
		data-reveal
	>
		<div class="container">
			<div class="home-highlight__layout">
				<div
					class="home-highlight__media home-media"
					style="--media-position: center center"
				>
					<Image
						src={photos.sitzprofil.image}
						alt={t(photos.sitzprofil.alt)}
						format="webp"
						widths={mobileWidths}
						sizes="(min-width: 64rem) 50vw, 100vw"
						loading="lazy"
						decoding="async"
						class="home-media__img"
					/>
				</div>
				<div class="home-highlight__content">
					<p class="section-eyebrow">{t("Einblick")}</p>
					<h2 id="highlight-heading" class="section-title">{t("Ruhe und Präsenz")}</h2>
					<p class="home-highlight__text">
						{t("Ausgeglichene Haltung, aufmerksames Wesen — Eigenschaften, die in der weiteren Entwicklung beobachtet und dokumentiert werden.")}
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- 7. Call to action -->
	<section class="home-section home-cta" aria-labelledby="cta-heading" data-reveal>
		<div class="container">
			<div class="home-cta__inner">
				<p class="home-cta__note">{t("Kontakt")}</p>
				<h2 id="cta-heading" class="home-cta__title">{t("Deckanfrage")}</h2>
				<p class="home-cta__text">
					{t("Für spätere Anfragen — der Bereich wird vorbereitet.")}
				</p>
				<a href={localizedHref("/deckanfrage", locale)} class="btn btn--primary">{t("Deckanfrage vorbereiten")}</a>
			</div>
		</div>
	</section>

	<!-- 8. Instagram -->
	<section class="home-section home-instagram" aria-labelledby="instagram-heading" data-reveal>
		<div class="container">
			<div class="home-instagram__inner">
				<div>
					<p class="section-eyebrow">{t("Dokumentation")}</p>
					<h2 id="instagram-heading" class="section-title">{t("Aktuelle Entwicklung")}</h2>
				</div>
				<p class="home-instagram__text">
					{t("Neue Eindrücke, Trainingseinheiten und Entwicklungen werden fortlaufend dokumentiert.")}
				</p>
				<a
					href={localizedHref(siteConfig.social.instagram, locale)}
					class="btn btn--pill"
					target="_blank"
					rel="noopener noreferrer"
				>
					<svg
						class="btn--pill__icon"
						viewBox="0 0 24 24"
						aria-hidden="true"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
					>
						<rect x="3" y="3" width="18" height="18" rx="5" />
						<circle cx="12" cy="12" r="4" />
						<circle cx="17.5" cy="6.5" r="0.75" fill="currentColor" stroke="none" />
					</svg>
					{t("Instagram folgen")}
				</a>
			</div>
		</div>
	</section>
</BaseLayout>
