---
import { getLocale, translator, localizedHref } from '../i18n';
const locale = getLocale(Astro.url.pathname);
const t = translator(locale);
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import { getCanonical } from '../config/site';
import '../styles/page-hero.css';
import '../styles/404.css';
---

<BaseLayout
	title={t("404 | SIR LUDWIG")}
	description={t("Seite nicht gefunden.")}
	canonical={getCanonical('/404')}
>
	<section class="not-found" aria-labelledby="not-found-title">
		<div class="container not-found__inner">
			<p class="page-hero__label">404</p>
			<h1 id="not-found-title" class="page-hero__title">{t("Seite nicht gefunden")}</h1>
			<p class="page-hero__intro">
				{t("Die angeforderte Seite konnte nicht gefunden werden oder wurde verschoben.")}
			</p>
			<p class="not-found__hint">
				{t("Nutzen Sie die Navigation oder kehren Sie direkt zur Startseite zurück.")}
			</p>
			<div class="not-found__actions">
				<a href={localizedHref("/", locale)} class="btn btn--primary not-found__cta">{t("Zur Startseite")}</a>
			</div>
		</div>
	</section>
</BaseLayout>
