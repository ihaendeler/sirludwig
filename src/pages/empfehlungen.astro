---
import { getLocale, translator, localizedHref } from '../i18n';
const locale = getLocale(Astro.url.pathname);
const t = translator(locale);
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { siteConfig, getCanonical } from '../config/site';
import { isRecommendationPending, recommendations } from '../data/recommendations';
import '../styles/empfehlungen.css';

const path = '/empfehlungen';
---

<BaseLayout
	title={t(`Empfehlungen — ${siteConfig.brandName}`)}
	description={t("Ausgewählte Hinweise rund um Ludwig, Pflege, Alltag und das Rudel FlyingRoyals von Reckewitz.")}
	canonical={getCanonical(path)}
>
	<PageHero
		label={t("Empfehlungen")}
		title={t("Links und Empfehlungen")}
		intro={t("Ausgewählte Hinweise rund um Ludwig, Pflege, Alltag und das Rudel FlyingRoyals von Reckewitz.")}
		headingId="recommendations-heading"
	/>

	<section class="rec-section" aria-label={t("Empfehlungen")}>
		<div class="container">
			<ul class="rec-list">
				{
					recommendations.map((item) => {
						const pending = isRecommendationPending(item);

						return (
							<li class="rec-item">
								<h3 class="rec-item__title">{t(item.title)}</h3>
								<p class="rec-item__text">{t(item.text)}</p>
								{pending ? (
									<p class="rec-item__pending">{t("Link folgt")}</p>
								) : (
									<a
										href={localizedHref(item.url, locale)}
										class="rec-item__link"
										target="_blank"
										rel="noopener noreferrer"
									>
										{t(item.linkLabel)}
									</a>
								)}
							</li>
						);
					})
				}
			</ul>
		</div>
	</section>
</BaseLayout>
