---
import { getLocale, translator, localizedHref } from '../i18n';
const locale = getLocale(Astro.url.pathname);
const t = translator(locale);
export const prerender = true;

import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { siteConfig, getCanonical } from '../config/site';
import '../styles/ludwig.css';

import { photos } from '../data/photos';

const path = '/ludwig';
const imageWidths = [480, 640, 828, 1080, 1280, 1920];

const projectGoals = [
	'Tuxedo Großpudel als klare Rasseführung',
	'Transparenz in Abstammung und Entwicklung',
	'Gesundheitsüberwachung im Rahmen des Aufbaus',
	'Dokumentation aller relevanten Schritte',
	'Langfristiger, bewusster Aufbau',
];
---

<BaseLayout
	title={t(`Ludwig — ${siteConfig.brandName}`)}
	description={t("Sir Ludwig — Tuxedo Großpudel by FlyingRoyals von Reckewitz. Herkunft, Charakter und Projektziel im Überblick.")}
	canonical={getCanonical(path)}
>
	<PageHero
		variant="media"
		class="ludwig-hero"
		label={t("Ludwig")}
		title={t("Tuxedo Großpudel mit ruhiger Präsenz")}
		intro={t("Sir Ludwig steht für einen bewusst geführten Aufbau — dokumentiert, transparent und ohne Eile.")}
		headingId="ludwig-heading"
	>
		<div slot="media" class="page-hero__media-frame">
			<Image
				src={photos.nahportraet.image}
				alt={t(photos.nahportraet.alt)}
				format="webp"
				widths={imageWidths}
				sizes="(min-width: 48rem) 55vw, 100vw"
				loading="eager"
				fetchpriority="high"
				decoding="async"
			/>
		</div>
	</PageHero>

	<!-- Herkunft -->
	<section class="ludwig-section" aria-labelledby="ludwig-origin-heading">
		<div class="container">
			<div class="ludwig-section__inner">
				<p class="ludwig-eyebrow">{t("Herkunft")}</p>
				<h2 id="ludwig-origin-heading" class="ludwig-title">{t("FlyingRoyals von Reckewitz")}</h2>
				<p class="ludwig-text">
					{t("Ludwig gehört zum Rudel FlyingRoyals von Reckewitz und wird als eigenständiger zukünftiger Deckrüde präsentiert.")}
				</p>
			</div>
		</div>
	</section>

	<!-- Auswahl -->
	<section class="ludwig-section" aria-labelledby="ludwig-selection-heading">
		<div class="container">
			<div class="ludwig-section__inner">
				<p class="ludwig-eyebrow">{t("Auswahl")}</p>
				<h2 id="ludwig-selection-heading" class="ludwig-title">{t("Bewusste Entscheidung")}</h2>
				<p class="ludwig-text">
					{t("Ludwig wurde aufgrund seiner Abstammung, Gesundheit und seines Potenzials als zukünftiger Deckrüde ausgewählt.")}
				</p>
			</div>
		</div>
	</section>

	<!-- Charakter -->
	<section class="ludwig-section" aria-labelledby="ludwig-character-heading">
		<div class="container">
			<div class="ludwig-story">
				<Image src={photos.alltagStock.image} alt={t(photos.alltagStock.alt)}
					format="webp" widths={imageWidths} sizes="(min-width: 48rem) 42vw, 100vw" loading="lazy" />
				<div class="ludwig-section__inner">
					<p class="ludwig-eyebrow">{t("Charakter")}</p>
					<h2 id="ludwig-character-heading" class="ludwig-title">{t("Beobachtung")}</h2>
					<p class="ludwig-text">
						{t("Ludwig wirkt ruhig und aufmerksam. Er ist menschenbezogen und zeigt ein klares, ausgeglichenes Wesen — ohne Hast, mit Präsenz.")}
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Projektziel -->
	<section class="ludwig-section" aria-labelledby="ludwig-goals-heading">
		<div class="container">
			<div class="ludwig-section__inner">
				<p class="ludwig-eyebrow">{t("Projektziel")}</p>
				<h2 id="ludwig-goals-heading" class="ludwig-title">{t("Langfristiger Aufbau")}</h2>
				<ul class="ludwig-goals">
					{projectGoals.map((goal) => <li>{t(goal)}</li>)}
				</ul>
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="ludwig-section ludwig-cta" aria-labelledby="ludwig-cta-heading">
		<div class="container">
			<div class="ludwig-cta__inner">
				<h2 id="ludwig-cta-heading" class="ludwig-title">{t("Deckanfrage")}</h2>
				<p class="ludwig-text">{t("Für spätere Anfragen — der Bereich wird vorbereitet.")}</p>
				<a href={localizedHref("/deckanfrage", locale)} class="btn btn--primary">{t("Zur Deckanfrage")}</a>
			</div>
		</div>
	</section>
</BaseLayout>
