---
import { getLocale, translator, localizedHref } from '../i18n';
const locale = getLocale(Astro.url.pathname);
const t = translator(locale);
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { siteConfig, getCanonical } from '../config/site';
import {
	dnaOptions,
	edOptions,
	existingLittersOptions,
	eyeOptions,
	federalStateOptions,
	hdOptions,
	patellaOptions,
} from '../data/deckanfrage-options';
import '../styles/deckanfrage.css';

const path = '/deckanfrage';
---

<BaseLayout
	title={t(`Deckanfrage — ${siteConfig.brandName}`)}
	description={t("Deckanfrage für Sir Ludwig. Kontaktweg wählen, die Hündin vorstellen und auf Wunsch eine Farbberechnung übernehmen. Alle Angaben vor dem Versand prüfen.")}
	canonical={getCanonical(path)}
>
	<PageHero
		label={t("Deckanfrage")}
		title={t("Deckanfrage")}
		intro={t("Ihre Hündin, Ihre Planung, Ihr Kontaktweg. Die wichtigsten Angaben reichen für eine erste Anfrage.")}
		headingId="inquiry-heading"
	/>

	<section class="inquiry-section" aria-labelledby="inquiry-form-heading">
		<div class="container">
			<h2 id="inquiry-form-heading" class="visually-hidden">{t("Anfrageformular")}</h2>

			<div class="inquiry-success" data-form-success hidden tabindex="-1">
				<p class="inquiry-success__headline" data-form-success-target>{t("✓ Anfrage erfolgreich übermittelt")}</p>
				<p class="inquiry-success__lead">{t("Vielen Dank für Ihre Deckanfrage.")}</p>
				<p class="inquiry-success__text">
					{t("Die Angaben wurden erfolgreich übermittelt und werden geprüft.")}
				</p>
				<a href={localizedHref("/", locale)} class="btn btn--primary inquiry-success__cta">{t("Zur Startseite")}</a>
			</div>

			<div class="inquiry-draft-tools">
				<label><input type="checkbox" data-save-draft /> {t("Entwurf für später auf diesem Gerät speichern")}</label>
				<button type="button" class="color-text-link" data-clear-draft>{t("Entwurf löschen")}</button>
				<p data-draft-status role="status" class="inquiry-field__hint"></p>
			</div>
			<p class="inquiry-form__intro">{t("Mit")} <span aria-hidden="true">*</span> {t("markierte Angaben sind erforderlich. Alles Weitere ist freiwillig. Ein gespeicherter Entwurf bleibt sieben Tage auf diesem Gerät.")}</p>
			<noscript><p>{t("Für das interaktive Formular aktivieren Sie bitte JavaScript. Sie erreichen uns auch unter")} <a href="mailto:deckanfrage@sirludwig.de">{t("deckanfrage@sirludwig.de")}</a>.</p></noscript>
			<form
				class="inquiry-form"
				action="/api/deckanfrage"
				method="post"
				novalidate
				data-inquiry-form
			>
				<input type="hidden" name="language" value={locale} />
				<input type="hidden" name="_form-started-at" value="" data-form-started-at />
				<input type="hidden" name="color-scenario" value="" data-color-scenario />
				<div data-inquiry-fields>

				<div class="inquiry-form__honeypot" aria-hidden="true">
					<label class="inquiry-field__label" for="_honeypot">{t("Website")}</label>
					<input
						class="inquiry-field__input"
						type="text"
						id="_honeypot"
						name="_honeypot"
						tabindex="-1"
						autocomplete="off"
					/>
				</div>
				<fieldset class="inquiry-form__group">
					<legend class="inquiry-form__legend">{t("Kontaktdaten")}</legend>
					<div class="inquiry-form__grid">
						<div class="inquiry-field inquiry-field--full">
							<label class="inquiry-field__label" for="contact-name">{t("Name")} <span aria-hidden="true">*</span></label>
							<input
								class="inquiry-field__input"
								type="text"
								id="contact-name"
								name="contact-name"
								required
								autocomplete="name"
							/>
						</div>
						<div class="inquiry-field">
							<label class="inquiry-field__label" for="contact-city">{t("Ort / Stadt")}</label>
							<input
								class="inquiry-field__input"
								type="text"
								id="contact-city"
								name="contact-city"
								autocomplete="address-level2"
							/>
						</div>
						<div class="inquiry-field">
							<label class="inquiry-field__label" for="contact-state">{t("Bundesland")}</label>
							<select
								class="inquiry-field__select"
								id="contact-state"
								name="contact-state"
								autocomplete="address-level1"
							>
								{federalStateOptions.map((option) => (
									<option value={option.value}>{t(option.label)}</option>
								))}
							</select>
						</div>
					</div>
				</fieldset>

				<fieldset class="inquiry-form__group" data-comm-section>
					<legend class="inquiry-form__legend">{t("Bevorzugte Kommunikation")} <span aria-hidden="true">*</span></legend>
					<p class="inquiry-field__hint">{t("Wählen Sie, wie Sie kontaktiert werden möchten.")}</p>

					<div class="inquiry-comm__choices" role="group" aria-label={t("Bevorzugte Kommunikationswege")}>
						<label class="inquiry-check">
							<input
								class="inquiry-check__input"
								type="checkbox"
								name="comm-pref"
								value="email"
								data-comm-toggle="email"
							/>
							<span class="inquiry-check__label">{t("E-Mail")}</span>
						</label>
						<label class="inquiry-check">
							<input
								class="inquiry-check__input"
								type="checkbox"
								name="comm-pref"
								value="phone"
								data-comm-toggle="phone"
							/>
							<span class="inquiry-check__label">{t("Telefon")}</span>
						</label>
						<label class="inquiry-check">
							<input
								class="inquiry-check__input"
								type="checkbox"
								name="comm-pref"
								value="whatsapp"
								data-comm-toggle="whatsapp"
							/>
							<span class="inquiry-check__label">{t("WhatsApp")}</span>
						</label>
						<label class="inquiry-check">
							<input
								class="inquiry-check__input"
								type="checkbox"
								name="comm-pref"
								value="instagram"
								data-comm-toggle="instagram"
							/>
							<span class="inquiry-check__label">{t("Instagram")}</span>
						</label>
					</div>

					<p class="inquiry-comm__error" data-comm-error hidden>
						{t("Bitte mindestens einen Kommunikationsweg auswählen.")}
					</p>

					<div class="inquiry-form__grid inquiry-comm__fields">
						<div class="inquiry-field inquiry-field--full inquiry-comm__field" data-comm-field="email">
							<label class="inquiry-field__label" for="comm-email">{t("E-Mail-Adresse")}</label>
							<input
								class="inquiry-field__input"
								type="email"
								id="comm-email"
								name="comm-email"
								autocomplete="email"
								inputmode="email"
								data-comm-input
							/>
						</div>
						<div class="inquiry-field inquiry-field--full inquiry-comm__field" data-comm-field="phone">
							<label class="inquiry-field__label" for="comm-phone">{t("Telefonnummer")}</label>
							<input
								class="inquiry-field__input"
								type="tel"
								id="comm-phone"
								name="comm-phone"
								autocomplete="tel"
								inputmode="tel"
								data-comm-input
							/>
						</div>
						<div
							class="inquiry-field inquiry-field--full inquiry-comm__field"
							data-comm-field="whatsapp"
						>
							<label class="inquiry-field__label" for="comm-whatsapp">{t("WhatsApp-Nummer")}</label>
							<input
								class="inquiry-field__input"
								type="tel"
								id="comm-whatsapp"
								name="comm-whatsapp"
								autocomplete="tel"
								inputmode="tel"
								data-comm-input
							/>
							<p class="inquiry-field__hint">{t("Kann mit der Telefonnummer identisch sein.")}</p>
						</div>
						<div
							class="inquiry-field inquiry-field--full inquiry-comm__field"
							data-comm-field="instagram"
						>
							<label class="inquiry-field__label" for="comm-instagram">{t("Instagram-Profil")}</label>
							<input
								class="inquiry-field__input"
								type="text"
								id="comm-instagram"
								name="comm-instagram"
								autocomplete="off"
								placeholder={t("@nutzername")}
								data-comm-input
							/>
						</div>
					</div>

					<p class="inquiry-form__privacy">
						{t("Die Angaben werden ausschließlich zur Bearbeitung der Deckanfrage verwendet.")}
						<a class="inquiry-form__privacy-link" href={localizedHref("/datenschutz", locale)}>{t("Datenschutzerklärung")}</a>
					</p>
				</fieldset>

				<fieldset class="inquiry-form__group">
					<legend class="inquiry-form__legend">{t("Hündin")}</legend>
					<div class="inquiry-form__grid">
						<div class="inquiry-field inquiry-field--full">
							<label class="inquiry-field__label" for="bitch-name">{t("Name der Hündin")}</label>
							<input
								class="inquiry-field__input"
								type="text"
								id="bitch-name"
								name="bitch-name"
							/>
						</div>
						<div class="inquiry-field">
							<label class="inquiry-field__label" for="bitch-birthdate">{t("Geburtsdatum")}</label>
							<input
								class="inquiry-field__input"
								type="date"
								id="bitch-birthdate"
								name="bitch-birthdate"
								data-bitch-birthdate
							/>
							<p class="inquiry-field__hint" data-bitch-age hidden></p>
						</div>
						<div class="inquiry-field">
							<label class="inquiry-field__label" for="bitch-color">{t("Farbe")}</label>
							<input
								class="inquiry-field__input"
								type="text"
								id="bitch-color"
								name="bitch-color"
							/>
						</div>
						<div class="inquiry-field">
							<label class="inquiry-field__label" for="bitch-size">{t("Größe")}</label>
							<div class="inquiry-field__control inquiry-field__control--unit">
								<input
									class="inquiry-field__input"
									type="number"
									id="bitch-size"
									name="bitch-size"
									min="1"
									max="99"
									step="1"
									inputmode="numeric"
									placeholder={t("58")}
								/>
								<span class="inquiry-field__unit" aria-hidden="true">{t("cm")}</span>
							</div>
						</div>
						<div class="inquiry-field">
							<label class="inquiry-field__label" for="bitch-weight">{t("Gewicht")}</label>
							<div class="inquiry-field__control inquiry-field__control--unit">
								<input
									class="inquiry-field__input"
									type="number"
									id="bitch-weight"
									name="bitch-weight"
									min="1"
									max="99"
									step="0.1"
									inputmode="decimal"
									placeholder={t("23")}
								/>
								<span class="inquiry-field__unit" aria-hidden="true">{t("kg")}</span>
							</div>
						</div>
						<div class="inquiry-field inquiry-field--full">
							<label class="inquiry-field__label" for="bitch-club">{t("Verein / Verband")}</label>
							<input
								class="inquiry-field__input"
								type="text"
								id="bitch-club"
								name="bitch-club"
							/>
						</div>
					</div>
				<div class="inquiry-color" id="color-inquiry">
						<div class="inquiry-color__summary" data-color-summary hidden tabindex="-1">
							<h3>{t("Ihre ausgewählte Kombination")}</h3>
							<ul data-color-summary-values></ul>
							<div class="inquiry-color__actions">
								<a href={localizedHref("/farbrechner/", locale)} class="inquiry-color__link" data-color-edit data-color-open>{t("Berechnung ändern")}</a>
								<button type="button" class="inquiry-color__link" data-color-remove>{t("Berechnung entfernen")}</button>
							</div>
						</div>
						<p class="inquiry-color__entry" data-color-entry>
							<a href={localizedHref("/farbrechner/", locale)} class="inquiry-color__link" data-color-open>{t("Zum Farbrechner und zur Erklärung")}</a>
							<span class="inquiry-field__hint">{t("Optional")}</span>
						</p>
					</div>
				</fieldset>

				<details class="inquiry-optional">
					<summary>{t("Gesundheitsangaben ergänzen")} <span>{t("Optional")}</span></summary>
					<fieldset class="inquiry-form__group">
					<legend class="visually-hidden">{t("Gesundheit")}</legend>
					<div class="inquiry-form__grid">
						<div class="inquiry-field">
							<label class="inquiry-field__label" for="health-hd">{t("HD")}</label>
							<select class="inquiry-field__select" id="health-hd" name="health-hd">
								{hdOptions.map((option) => (
									<option value={option.value}>{t(option.label)}</option>
								))}
							</select>
						</div>
						<div class="inquiry-field">
							<label class="inquiry-field__label" for="health-ed">{t("ED")}</label>
							<select class="inquiry-field__select" id="health-ed" name="health-ed">
								{edOptions.map((option) => (
									<option value={option.value}>{t(option.label)}</option>
								))}
							</select>
						</div>
						<div class="inquiry-field">
							<label class="inquiry-field__label" for="health-patella">{t("Patella")}</label>
							<select class="inquiry-field__select" id="health-patella" name="health-patella">
								{patellaOptions.map((option) => (
									<option value={option.value}>{t(option.label)}</option>
								))}
							</select>
						</div>
						<div class="inquiry-field">
							<label class="inquiry-field__label" for="health-eyes">{t("Augenuntersuchung")}</label>
							<select class="inquiry-field__select" id="health-eyes" name="health-eyes">
								{eyeOptions.map((option) => (
									<option value={option.value}>{t(option.label)}</option>
								))}
							</select>
						</div>
						<div class="inquiry-field inquiry-field--full">
							<label class="inquiry-field__label" for="health-dna">{t("DNA-Tests")}</label>
							<select class="inquiry-field__select" id="health-dna" name="health-dna">
								{dnaOptions.map((option) => (
									<option value={option.value}>{t(option.label)}</option>
								))}
							</select>
						</div>
					</div>
				</fieldset>
				</details>

				<fieldset class="inquiry-form__group">
					<legend class="inquiry-form__legend">{t("Planung")}</legend>
					<div class="inquiry-form__grid">
						<div class="inquiry-field inquiry-field--full">
							<label class="inquiry-field__label" for="plan-period">{t("Geplanter Deckzeitraum")}</label>
							<input
								class="inquiry-field__input"
								type="text"
								id="plan-period"
								name="plan-period"
							/>
						</div>
						<div class="inquiry-field">
							<label class="inquiry-field__label" for="plan-existing-litters"
								>{t("Bereits vorhandene Würfe?")}</label
							>
							<select
								class="inquiry-field__select"
								id="plan-existing-litters"
								name="plan-existing-litters"
							>
								{existingLittersOptions.map((option) => (
									<option value={option.value}>{t(option.label)}</option>
								))}
							</select>
						</div>
					</div>
				</fieldset>

				<fieldset class="inquiry-form__group">
					<legend class="inquiry-form__legend">{t("Nachricht")}</legend>
					<div class="inquiry-field">
						<label class="inquiry-field__label" for="message">{t("Freitextfeld")}</label>
						<textarea
							class="inquiry-field__textarea"
							id="message"
							name="message"
							rows="6"></textarea>
					</div>
				</fieldset>

				<div class="inquiry-form__consent">
					<div class="inquiry-consent">
						<input
							class="inquiry-consent__input"
							type="checkbox"
							id="privacy-consent"
							name="privacy-consent"
							value="yes"
							required
							data-privacy-consent
						/>
						<div class="inquiry-consent__content">
							<label class="inquiry-consent__label" for="privacy-consent">
								{t("Ich habe die")}{t(' ')}
								<a class="inquiry-form__privacy-link" href={localizedHref("/datenschutz", locale)} data-consent-link>
									{t("Datenschutzerklärung")}
								</a>{t(' ')}
								{t("gelesen und bin damit einverstanden, dass meine Angaben zur Bearbeitung der Deckanfrage verarbeitet werden.")}
							</label>
							<p class="inquiry-consent__hint">
								{t("Die Angaben werden ausschließlich zur Bearbeitung der Anfrage verwendet.")}
							</p>
						</div>
					</div>
				</div>

				<div class="inquiry-form__actions">
					<button type="button" class="btn btn--primary inquiry-form__submit" data-review-button>{t("Angaben prüfen")}</button>
				</div>
				</div>
				<p class="inquiry-form__status inquiry-form__status--error" data-form-error hidden role="alert"></p>
				<section class="inquiry-review" data-inquiry-review hidden aria-labelledby="inquiry-review-title" tabindex="-1">
					<p class="inquiry-eyebrow">{t("Vor dem Absenden")}</p>
					<h2 id="inquiry-review-title">{t("Ihre Anfrage im Überblick")}</h2>
					<div data-review-content></div>
					<div class="inquiry-review__actions">
						<button type="button" class="btn btn--secondary" data-review-edit>{t("Angaben bearbeiten")}</button>
						<button type="submit" class="btn btn--primary" data-inquiry-submit>{t("Anfrage absenden")}</button>
					</div>
				</section>
			</form>
		</div>
	</section>

	<section class="inquiry-notice" aria-labelledby="inquiry-notice-heading">
		<div class="container">
			<div class="inquiry-notice__inner">
				<p class="inquiry-eyebrow">{t("Hinweis")}</p>
				<h2 id="inquiry-notice-heading" class="inquiry-title">{t("Aktueller Stand")}</h2>
				<p class="inquiry-text">
					{t("Ludwig befindet sich aktuell im Aufbau als zukünftiger Deckrüde. Die Seite dient der Dokumentation seiner Entwicklung. Verfügbarkeiten und Voraussetzungen werden zu gegebener Zeit veröffentlicht.")}
				</p>
			</div>
		</div>
	</section>
</BaseLayout>

<script>
	import '../scripts/inquiry';
</script>

<style>
	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
