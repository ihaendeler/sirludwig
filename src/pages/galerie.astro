---
import { getLocale, translator } from '../i18n';
const locale = getLocale(Astro.url.pathname);
const t = translator(locale);
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { getCanonical } from '../config/site';

const path = '/galerie';
const placeholderIntro =
	'Dieser Bereich ist vorbereitet und wird in einer späteren Phase ausgearbeitet.';
---

<BaseLayout
	title={t("Galerie — Platzhalter")}
	description={t("Bereich Galerie — in Vorbereitung.")}
	canonical={getCanonical(path)}
>
	<PageHero
		label={t("Bereich")}
		title={t("Galerie")}
		intro={t(placeholderIntro)}
		headingId="page-heading"
	/>
</BaseLayout>
