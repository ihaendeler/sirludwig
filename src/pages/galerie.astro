---
import { getLocale, translator } from '../i18n';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { getCanonical } from '../config/site';
import { gallerySections } from '../data/photos';
import '../styles/gallery.css';
export const prerender = true;
const locale = getLocale(Astro.url.pathname);
const t = translator(locale);
let offset = 0;
const sections = await Promise.all(gallerySections.map(async (section) => {
  const start = offset;
  offset += section.photos.length;
  return { ...section, pictures: await Promise.all(section.photos.map(async (photo, index) => ({ ...photo,
    index: start + index,
    large: await getImage({ src: photo.image, width: Math.min(1920, photo.image.width), format: 'webp', quality: 88 }),
  }))) };
}));
---

<BaseLayout title={t('Galerie — SIR LUDWIG')}
  description={t('Sir Ludwig in Bildern: Porträts, Bewegung und kleine Pausen draußen in der Natur.')}
  canonical={getCanonical('/galerie')}>
  <PageHero label={t('Einblicke')} title={t('Unterwegs mit Ludwig')}
    intro={t('Ein wacher Blick, fliegende Ohren, ein guter Fund am Wegesrand. Ludwig draußen in seinem Element.')}
    headingId="gallery-heading" />
  <section class="gallery-section" aria-labelledby="gallery-heading">
    <div class="container">
      <nav class="gallery-jump" aria-label={t('Galeriebereiche')}>
        {sections.map((section) => <a href={`#${section.id}`}>{t(section.title)}</a>)}
      </nav>
      {sections.map((section) => (
      <section class="gallery-chapter" id={section.id} aria-labelledby={`gallery-${section.id}`}>
      <header class="gallery-series">
        <h2 id={`gallery-${section.id}`}>{t(section.title)}</h2>
        <p>{t(section.date)}</p>
      </header>
      <div class="gallery-grid">
        {section.pictures.map((photo) => (
          <figure class="gallery-item">
            <a href={photo.large.src} data-gallery-open data-gallery-index={photo.index}
              data-caption={t(photo.title)} aria-label={`${t('Foto vergrößern')}: ${t(photo.title)}`}>
              <Image src={photo.image} alt={t(photo.alt)} format="webp"
                widths={[480, 640, 828, 1080, 1440].filter((width) => width <= photo.image.width)} sizes="(min-width: 72rem) 30vw, (min-width: 40rem) 46vw, 100vw"
                loading="lazy" decoding="async" />
              <span class="gallery-item__expand" aria-hidden="true">↗</span>
            </a>
            <figcaption><span>{t(photo.title)}</span><span class="gallery-item__number" aria-hidden="true">{String(photo.index + 1).padStart(2, '0')}</span></figcaption>
          </figure>
        ))}
      </div>
      </section>
      ))}
    </div>
  </section>
  <dialog class="photo-viewer" aria-labelledby="photo-caption" data-photo-viewer>
    <button type="button" class="photo-viewer__close" data-photo-close autofocus aria-label={t('Bildansicht schließen')}>×</button>
    <div class="photo-viewer__stage">
      <button type="button" class="photo-viewer__previous" data-photo-previous aria-label={t('Vorheriges Foto')}>←</button>
      <figure>
        <img data-photo-image alt="" width="1446" height="1920" />
        <figcaption id="photo-caption" data-photo-caption aria-live="polite"></figcaption>
      </figure>
      <button type="button" class="photo-viewer__next" data-photo-next aria-label={t('Nächstes Foto')}>→</button>
    </div>
  </dialog>
</BaseLayout>
<script>
  import '../scripts/gallery';
</script>
