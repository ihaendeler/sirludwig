{
  "name": "sirludwig",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "generate:og": "node --import tsx src/scripts/generate-og.ts",
    "generate:icons": "node --import tsx src/scripts/generate-favicons.ts",
    "prebuild": "npm run generate:og && npm run generate:icons",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check && tsc --noEmit && tsc -p functions/tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "postbuild": "node --import tsx src/scripts/check-locales.ts"
  },
  "dependencies": {
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261023.1",
    "@types/node": "^22.20.5",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
